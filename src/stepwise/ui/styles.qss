/* Stepwise Modern Desktop Theme (Default: High-Contrast Enterprise Dark Palette) */

* {
    font-family: "Malgun Gothic", "Segoe UI", -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
    font-size: 13px;
    color: #f1f5f9;
}

QMainWindow, QDialog {
    background-color: #0f172a;
    color: #f1f5f9;
}

/* Toolbar */
QToolBar {
    background-color: #1e293b;
    border-bottom: 1px solid #334155;
    padding: 6px 12px;
    spacing: 8px;
}

QToolBar QLabel {
    color: #94a3b8;
    font-weight: 600;
}

QToolBar QPushButton {
    background-color: #1e293b;
    color: #f1f5f9;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 6px 14px;
    font-weight: 600;
    min-height: 22px;
}

QToolBar QPushButton:hover {
    background-color: #334155;
    border-color: #94a3b8;
    color: #f8fafc;
}

/* General Buttons */
QPushButton {
    background-color: #1e293b;
    color: #f1f5f9;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: 600;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #334155;
    border-color: #94a3b8;
    color: #f8fafc;
}

QPushButton:pressed {
    background-color: #475569;
    color: #f8fafc;
}

QPushButton:disabled {
    background-color: #0f172a;
    color: #64748b;
    border-color: #1e293b;
}

/* Primary Execution Buttons */
QPushButton#btn_run {
    background-color: #16a34a;
    color: #ffffff;
    font-weight: bold;
    border-radius: 6px;
    padding: 6px 18px;
    border: 1px solid #15803d;
}

QPushButton#btn_run:hover {
    background-color: #15803d;
    color: #ffffff;
}

QPushButton#btn_pause {
    background-color: #d97706;
    color: #ffffff;
    font-weight: bold;
    border-radius: 6px;
    padding: 6px 16px;
    border: 1px solid #b45309;
}

QPushButton#btn_pause:hover {
    background-color: #b45309;
    color: #ffffff;
}

QPushButton#btn_stop {
    background-color: #dc2626;
    color: #ffffff;
    font-weight: bold;
    border-radius: 6px;
    padding: 6px 16px;
    border: 1px solid #b91c1c;
}

QPushButton#btn_stop:hover {
    background-color: #b91c1c;
    color: #ffffff;
}

QPushButton#btn_schedule {
    background-color: #4f46e5;
    color: #ffffff;
    font-weight: bold;
    border-radius: 6px;
    padding: 6px 14px;
    border: 1px solid #4338ca;
}

QPushButton#btn_schedule:hover {
    background-color: #4338ca;
    color: #ffffff;
}

/* Tree, Lists & Tables */
QTreeView, QTreeWidget, QListView, QListWidget, QTableView, QTableWidget {
    background-color: #0b1120;
    alternate-background-color: #131c31;
    color: #f1f5f9;
    border: 1px solid #334155;
    border-radius: 6px;
    gridline-color: #1e293b;
    selection-background-color: #1d4ed8;
    selection-color: #f8fafc;
    outline: none;
}

QTreeView::item, QListWidget::item, QTableWidget::item {
    padding: 5px 8px;
    color: #f1f5f9;
    border-bottom: 1px solid #1e293b;
}

QTreeView::item:hover, QListWidget::item:hover, QTableWidget::item:hover {
    background-color: #334155;
    color: #f8fafc;
}

QTreeView::item:selected, QListWidget::item:selected, QTableWidget::item:selected {
    background-color: #1d4ed8;
    color: #f8fafc;
    font-weight: 600;
}

/* Table and Tree Headers */
QHeaderView::section {
    background-color: #1e293b;
    color: #f8fafc;
    padding: 6px 8px;
    border: none;
    border-bottom: 1px solid #334155;
    border-right: 1px solid #334155;
    font-weight: bold;
}

/* Tabs */
QTabWidget {
    background-color: #0f172a;
}

QTabWidget::pane {
    border: 1px solid #334155;
    background-color: #1e293b;
    border-radius: 6px;
    top: -1px;
}

QTabBar::tab {
    background-color: #0f172a;
    color: #94a3b8;
    padding: 8px 18px;
    border: 1px solid #334155;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 3px;
    font-weight: 600;
}

QTabBar::tab:selected {
    background-color: #1e293b;
    color: #38bdf8;
    border-bottom: 1px solid #1e293b;
    font-weight: bold;
}

QTabBar::tab:hover:!selected {
    background-color: #334155;
    color: #f1f5f9;
}

/* Scroll Areas & Containers */
QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget {
    background-color: transparent;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* Group Boxes / Panels */
QGroupBox {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    margin-top: 14px;
    padding: 12px;
    font-weight: 600;
    color: #f8fafc;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    background-color: #1e293b;
    color: #38bdf8;
    font-weight: bold;
}

/* Inputs */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit, QPlainTextEdit, QTimeEdit {
    background-color: #0b1120;
    border: 1px solid #334155;
    border-radius: 5px;
    padding: 5px 10px;
    color: #f1f5f9;
    selection-background-color: #1d4ed8;
    selection-color: #f8fafc;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QTextEdit:focus, QPlainTextEdit:focus, QTimeEdit:focus {
    border-color: #0284c7;
    outline: none;
}

QComboBox::drop-down {
    border: none;
    padding-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #1e293b;
    color: #f1f5f9;
    selection-background-color: #1d4ed8;
    selection-color: #f8fafc;
    border: 1px solid #334155;
}

/* Checkboxes & Radio Buttons */
QCheckBox, QRadioButton {
    color: #f1f5f9;
    spacing: 6px;
}

QCheckBox:disabled, QRadioButton:disabled {
    color: #64748b;
}

/* Status Bar */
QStatusBar {
    background-color: #1e293b;
    border-top: 1px solid #334155;
    color: #94a3b8;
    padding: 4px 12px;
    font-weight: 500;
}

QStatusBar QLabel {
    color: #94a3b8;
    font-weight: 500;
}

/* Context Menus */
QMenu {
    background-color: #1e293b;
    color: #f1f5f9;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px;
    border-radius: 4px;
    color: #f1f5f9;
}

QMenu::item:selected {
    background-color: #1d4ed8;
    color: #f8fafc;
}

QMenu::separator {
    height: 1px;
    background-color: #334155;
    margin: 4px 8px;
}

/* Splitters */
QSplitter::handle {
    background-color: #334155;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

QSplitter::handle:hover {
    background-color: #38bdf8;
}

/* Scrollbars */
QScrollBar:vertical {
    background: #0f172a;
    width: 10px;
    margin: 0px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #334155;
    min-height: 24px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: #0f172a;
    height: 10px;
    margin: 0px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background: #334155;
    min-width: 24px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background: #94a3b8;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}
